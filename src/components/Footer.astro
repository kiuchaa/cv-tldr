---
import { getCv } from '../data/cv';
import { getUi } from '../data/ui';
import { cvPdfPath, getLocale } from '../i18n';
import ArrowLink from './ArrowLink.astro';
import Rich from './Rich.astro';

const locale = getLocale(Astro.currentLocale);
const cv = getCv(locale);
const ui = getUi(locale);
const isUrl = (value: string) => /^https?:\/\//.test(value);
const displayUrl = (href: string) => href.replace(/^https?:\/\//, '');

const links = [
	{ label: 'Portfolio', href: cv.contact.portfolio },
	{ label: 'LinkedIn', href: cv.contact.linkedin },
	{ label: 'GitHub', href: cv.contact.github },
	{ label: 'Hevy', href: cv.contact.hevy },
	{ label: '𝕏', href: cv.contact.x },
].filter((link) => isUrl(link.href));

const printLinks = links.filter((link) => link.label !== 'Hevy');
---

<footer id="contact" class="bg-blue-500 py-16 text-blue-100 selection:bg-blue-100 selection:text-blue-500">
	<div class="mx-auto w-full max-w-xl space-y-24 px-6 sm:px-0 print:space-y-6">
		{/* Screen layout — flex/grow borders break Chromium PDF link hit-boxes */}
		<div class="no-print grid grid-cols-1 gap-16 sm:grid-cols-12 sm:gap-6">
			<div class="sm:col-span-3">
				<h2 class="font-serif text-base leading-6 font-normal italic">{ui.contact}</h2>
			</div>
			<div class="space-y-3 sm:col-span-9">
				<div class="flex items-center gap-3">
					<p class="text-base leading-6">{ui.email}</p>
					<hr class="grow border-blue-100" />
					<div class="flex items-center gap-1">
						<a href={`mailto:${cv.contact.email}`} class="text-base leading-6">
							{cv.contact.email}
						</a>
						<button
							type="button"
							class="cursor-pointer transition-colors ease-in hover:text-white"
							aria-label="Copy"
							data-copy={cv.contact.email}
						>
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" class="size-4" aria-hidden="true">
								<rect x="5.5" y="5.5" width="8" height="8" rx="0" />
								<path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
							</svg>
						</button>
					</div>
				</div>
				{
					links.map((link) => (
						<div class="flex items-center gap-3">
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								class="group/link flex items-center gap-1"
							>
								<span class="whitespace-nowrap">{link.label}</span>
								<svg
									viewBox="0 0 16 16"
									fill="none"
									stroke="currentColor"
									stroke-width="1"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-4 text-inherit transition-transform duration-300 group-hover/link:-translate-y-1"
									aria-hidden="true"
								>
									<path d="M5 11 11 5M5.5 5H11v5.5" />
								</svg>
							</a>
							<hr class="grow border-blue-100" />
						</div>
					))
				}
				<div class="flex items-center gap-3">
					<ArrowLink href={cvPdfPath(locale)} label={ui.downloadCv} inheritColor />
					<hr class="grow border-blue-100" />
				</div>
			</div>
		</div>

		{/* Print: plain block links so PDF annotations match visible text */}
		<div class="print-only print-contact">
			<h2 class="font-serif text-base leading-6 font-normal italic">{ui.contact}</h2>
			<p>
				<a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
			</p>
			{
				printLinks.map((link) => (
					<p>
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							{displayUrl(link.href)}
						</a>
					</p>
				))
			}
		</div>

		<div class="no-print space-y-6">
			<p class="text-base leading-6">
				<Rich content={cv.quote} accentClass="text-white" />
			</p>
			<hr class="border-blue-100" />
			<div class="pt-1 text-right">
				<small class="text-xs leading-4">© {new Date().getFullYear()} {cv.name}</small>
			</div>
		</div>
	</div>
</footer>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		button.addEventListener('click', async () => {
			const value = button.dataset.copy;
			if (!value) return;
			await navigator.clipboard.writeText(value);
			button.classList.add('text-white');
			setTimeout(() => button.classList.remove('text-white'), 1200);
		});
	});
</script>
