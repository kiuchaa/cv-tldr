---
import { getCv } from '../data/cv';
import { getUi } from '../data/ui';
import { getLocale } from '../i18n';
import ArrowLink from './ArrowLink.astro';
import Section from './Section.astro';

const locale = getLocale(Astro.currentLocale);
const cv = getCv(locale);
const ui = getUi(locale);
const widths = [400, 406, 450];
---

{
	cv.books.length > 0 && (
		<Section title={ui.bookshelf} id="bookshelf" layout="stack" class="no-print">
			<div class="flex max-w-2xl flex-col items-center gap-1">
				{cv.books.map((book, index) => {
					const Tag = book.href ? 'a' : 'div';
					return (
						<Tag
							href={book.href}
							target={book.href ? '_blank' : undefined}
							rel={book.href ? 'noopener noreferrer' : undefined}
							class="flex max-w-full items-center justify-between gap-8 px-8 py-3"
							style={`color:${book.color};background-color:${book.background};width:${widths[index % widths.length]}px`}
						>
							<div class="flex flex-col">
								<p class="text-base leading-6">{book.title}</p>
								<small class="font-serif text-xs leading-4 italic">{book.author}</small>
							</div>
							{book.cover ? (
								<img src={book.cover} alt={book.title} loading="lazy" class="h-22 w-auto" />
							) : (
								<div class="h-22 w-15 bg-current opacity-15" aria-hidden="true" />
							)}
						</Tag>
					);
				})}
			</div>
			{cv.booksHref && (
				<div class="flex justify-end">
					<ArrowLink href={cv.booksHref} label={ui.moreBooks} external />
				</div>
			)}
		</Section>
	)
}
